# CTI Platform — Environment Variables
# Copy this file to .env and fill in your values

APP_NAME="CTI Platform"
DEBUG=false

# Database (SQLite by default; swap for PostgreSQL in production)
DATABASE_URL=sqlite:///./cti.db
# DATABASE_URL=postgresql://user:password@localhost:5432/cti_db

# --- Enrichment API Keys ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=

# --- Email Alerts (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=
ALERT_EMAIL_TO=soc@yourcompany.com

# --- Slack Alerts ---
SLACK_WEBHOOK_URL=

# --- Risk Score Thresholds ---
HIGH_RISK_SCORE=50
MEDIUM_RISK_SCORE=25
